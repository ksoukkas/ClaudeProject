# Copy this file to .env.local and fill in values. Never commit real values.

# Optional. When set, the scout uses Claude to parse the search and to draft
# "why call" lines from the structured facts. When empty, a keyword parser and
# template sentences are used and the UI says so. Server-side only.
ANTHROPIC_API_KEY=
# Optional. Claude model for the scout. Defaults to claude-opus-5-5.
SCOUT_MODEL=
